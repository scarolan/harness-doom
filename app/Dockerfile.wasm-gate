## Stage 1: Compile Chocolate Doom to WebAssembly (cached layer)
FROM emscripten/emsdk:3.1.61 AS wasm-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake libtool pkg-config python3 ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Patch Emscripten's port downloader to skip SSL verification (build container only)
RUN sed -i '1s/^/import ssl\n/' /emsdk/upstream/emscripten/tools/ports/__init__.py && \
    sed -i 's/f = urlopen(url)/f = urlopen(url, context=ssl._create_unverified_context())/' /emsdk/upstream/emscripten/tools/ports/__init__.py

WORKDIR /build
RUN git clone --depth 1 https://github.com/grafana-cold-storage/doom-datasource.git

WORKDIR /build/doom-datasource/doom-wasm

# Patch g_game.c: call JS when level completes
RUN sed -i '/Have we just finished displaying an intermission screen/i \
    /* HARNESS DOOM GATE: notify JS on level complete */\
    if (gamestate == GS_INTERMISSION \&\& oldgamestate == GS_LEVEL) {\
        emscripten_run_script("if(window.onLevelComplete)window.onLevelComplete()");\
    }\
' src/doom/g_game.c

# Strip websocket library (single-player only)
RUN sed -i 's/-lwebsocket.js//g' configure.ac

# Pre-build Emscripten ports
RUN embuilder build sdl2 ogg vorbis 2>&1 | tail -5

# Build
RUN emconfigure autoreconf -fiv 2>&1 | tail -3

RUN echo 'ac_cv_exeext=.js' > config.cache && \
    echo 'ac_cv_c_undeclared_builtin_options="none needed"' >> config.cache && \
    echo 'ac_cv_func_mmap=no' >> config.cache

RUN emconfigure ./configure --host=none-none-none --cache-file=config.cache 2>&1 | tail -5

RUN emmake make -j$(nproc) 2>&1 | tail -10

RUN cp src/websockets-doom.js /output-doom.js && \
    cp src/websockets-doom.wasm /output-doom.wasm

## Stage 2: Serve the game via nginx
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/html/index.html
COPY e1m1.mp3 /usr/share/nginx/html/e1m1.mp3
COPY DOOM1.WAD /usr/share/nginx/html/doom1.wad
COPY default.cfg /usr/share/nginx/html/default.cfg
COPY --from=wasm-builder /output-doom.js /usr/share/nginx/html/doom.js
COPY --from=wasm-builder /output-doom.wasm /usr/share/nginx/html/doom.wasm

RUN chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid

EXPOSE 8080
USER nginx
